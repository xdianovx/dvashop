<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env force="true" name="APP_ENV" value="testing"/>
        <env force="true" name="APP_KEY" value="base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="/>
        <env force="true" name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env force="true" name="BCRYPT_ROUNDS" value="4"/>
        <env force="true" name="BROADCAST_CONNECTION" value="null"/>
        <env force="true" name="CACHE_STORE" value="array"/>
        <env force="true" name="DB_CONNECTION" value="sqlite"/>
        <env force="true" name="DB_DATABASE" value=":memory:"/>
        <env force="true" name="DB_URL" value=""/>
        <env force="true" name="MAIL_MAILER" value="array"/>
        <env force="true" name="QUEUE_CONNECTION" value="sync"/>
        <env force="true" name="SESSION_DRIVER" value="array"/>
        <env force="true" name="SHOP_ORDERS_BITRIX_ENABLED" value="false"/>
        <env force="true" name="SHOP_INQUIRIES_BITRIX_ENABLED" value="false"/>
        <env force="true" name="BITRIX_WEBHOOK_URL" value=""/>
        <env force="true" name="BITRIX_ORDER_PRODUCT_ROWS_ENABLED" value="false"/>
        <env force="true" name="SHOP_ORDERS_CUSTOMER_EMAIL_ENABLED" value="false"/>
        <env force="true" name="SHOP_ORDERS_MANAGER_EMAIL_ENABLED" value="false"/>
        <env force="true" name="SHOP_INQUIRIES_EMAIL_ENABLED" value="false"/>
        <env force="true" name="PULSE_ENABLED" value="false"/>
        <env force="true" name="TELESCOPE_ENABLED" value="false"/>
        <env force="true" name="NIGHTWATCH_ENABLED" value="false"/>

        <!--
            Docker injects the application .env values into $_SERVER. Laravel's
            environment repository reads $_SERVER before $_ENV, while PHPUnit's
            <env> handler only overwrites getenv() and $_ENV. Keep matching
            <server> values so php artisan test always boots an isolated testing
            application instead of the local Docker application.
        -->
        <server name="APP_ENV" value="testing"/>
        <server name="APP_KEY" value="base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="/>
        <server name="APP_MAINTENANCE_DRIVER" value="file"/>
        <server name="BCRYPT_ROUNDS" value="4"/>
        <server name="BROADCAST_CONNECTION" value="null"/>
        <server name="CACHE_STORE" value="array"/>
        <server name="DB_CONNECTION" value="sqlite"/>
        <server name="DB_DATABASE" value=":memory:"/>
        <server name="DB_URL" value=""/>
        <server name="MAIL_MAILER" value="array"/>
        <server name="QUEUE_CONNECTION" value="sync"/>
        <server name="SESSION_DRIVER" value="array"/>
        <server name="SHOP_ORDERS_BITRIX_ENABLED" value="false"/>
        <server name="SHOP_INQUIRIES_BITRIX_ENABLED" value="false"/>
        <server name="BITRIX_WEBHOOK_URL" value=""/>
        <server name="BITRIX_ORDER_PRODUCT_ROWS_ENABLED" value="false"/>
        <server name="SHOP_ORDERS_CUSTOMER_EMAIL_ENABLED" value="false"/>
        <server name="SHOP_ORDERS_MANAGER_EMAIL_ENABLED" value="false"/>
        <server name="SHOP_INQUIRIES_EMAIL_ENABLED" value="false"/>
        <server name="PULSE_ENABLED" value="false"/>
        <server name="TELESCOPE_ENABLED" value="false"/>
        <server name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
